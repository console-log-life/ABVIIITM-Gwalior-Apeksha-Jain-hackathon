# Copy to .env and edit. The app runs with ZERO keys set (keyless sources + cache).

# --- Runtime mode: LIVE | REPLAY | SCENARIO ---
APP_MODE=SCENARIO
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Directory for rotating log files
LOG_DIR=./logs

# --- Storage ---
# SQLite database file
DB_PATH=./data/risk_engine.db
# Directory with captured real articles (REPLAY mode)
CACHE_DIR=./data/cache

# --- API / dashboard ---
API_HOST=127.0.0.1
API_PORT=8000
# Base URL the Streamlit dashboard uses to reach the API
API_BASE_URL=http://127.0.0.1:8000

# --- Optional API keys (leave blank to skip the source cleanly) ---
# Finnhub free key from https://finnhub.io (company news, ~60 req/min)
FINNHUB_API_KEY=
# Bluesky account handle (e.g. yourname.bsky.social) — used for authenticated app.bsky.feed.searchPosts
BLUESKY_HANDLE=
# Bluesky APP PASSWORD (Settings > Privacy and security > App passwords). Never your main password.
BLUESKY_APP_PASSWORD=

# --- HTTP behaviour ---
# Descriptive User-Agent sent to every source
USER_AGENT=risk-signal-engine/0.1 (hackathon research prototype; contact: your-email@example.com)
# Per-request timeout in seconds (general sources, max 10)
HTTP_TIMEOUT_S=10
# GDELT timeout in seconds (max 20)
GDELT_TIMEOUT_S=20
# Retries per external call (max 2)
HTTP_MAX_RETRIES=2
# Seconds between ingestion cycles in LIVE mode
INGEST_INTERVAL_S=300

# --- Models ---
# Local directory where scripts/setup_models.py stores model weights
MODEL_CACHE_DIR=./models
FINBERT_MODEL=ProsusAI/finbert
# Sentiment backend: auto (FinBERT, lexicon fallback if it cannot load) | finbert | lexicon
SENTIMENT_BACKEND=auto
# CPU threads used by torch for FinBERT (2 keeps the demo laptop responsive)
TORCH_THREADS=2
# Optional zero-shot tie-breaker (off unless evaluation shows it helps)
ENABLE_ZERO_SHOT=false
ZERO_SHOT_MODEL=typeform/distilbert-base-uncased-mnli
# Fine-tuned models (see docs/TRAINING.md). Loaded when the folder exists; empty = base FinBERT / rules only.
MODEL_SENTIMENT_PATH=./models/finetuned/sentiment_finbert_ft
MODEL_EVENT_PATH=./models/finetuned/event_distilroberta_ft
# Hybrid events: rules win for these classes at/above this rule score; else the model if confidence >= threshold
EVENT_RULES_AUTHORITATIVE=["Credit Event","Supply Chain","Litigation"]
EVENT_RULES_AUTHORITATIVE_MIN_SCORE=2.0
EVENT_MODEL_MIN_CONFIDENCE=0.6
# int8 dynamic quantisation of the transformer Linear layers (less RAM, faster on CPU, tiny accuracy change)
MODEL_QUANTIZE_INT8=false
# Set both to 1 for the offline demo after setup_models.py has run
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# --- NLP thresholds ---
SENTIMENT_NEG_THRESHOLD=-0.25
SENTIMENT_POS_THRESHOLD=0.25
# rapidfuzz near-duplicate title threshold (0-100)
NEAR_DUP_THRESHOLD=92
# Corroboration window in hours
CORROBORATION_WINDOW_H=6

# --- Stress triggers ---
TRIGGER_SYSTEMIC_MIN_IMPACT=7.0
TRIGGER_SYSTEMIC_SEVERE_IMPACT=8.5
TRIGGER_IDIOSYNCRATIC_MIN_IMPACT=6.0
# Idiosyncratic stress only when sentiment <= this (positive court/regulator news must not trigger)
TRIGGER_IDIOSYNCRATIC_MAX_SENTIMENT=-0.25
TRIGGER_COOLDOWN_MIN=30
# Sources allowed to TRIGGER systemic (market-level) stress; social sources can only add corroboration (JSON list)
SYSTEMIC_TRIGGER_SOURCES=["google_news","finnhub","gdelt"]

# Early-warning watchlist (GET /watchlist). "Negative" = sentiment <= WATCHLIST_NEGATIVE_SENTIMENT.
# WATCH-NEGATIVE: one negative signal with impact >= WATCHLIST_WATCH_IMPACT, or >= WATCHLIST_WATCH_COUNT negative
# signals with impact >= WATCHLIST_WATCH_COUNT_IMPACT. MONITOR: one negative signal with impact >= WATCHLIST_MONITOR_IMPACT.
WATCHLIST_WINDOW_H=24
WATCHLIST_NEGATIVE_SENTIMENT=-0.25
WATCHLIST_WATCH_IMPACT=7.0
WATCHLIST_WATCH_COUNT=2
WATCHLIST_WATCH_COUNT_IMPACT=5.0
WATCHLIST_MONITOR_IMPACT=4.0
# Risk-appetite limit as % of portfolio MV (green <1%, amber 1-limit, red >limit)
RISK_APPETITE_LOSS_PCT=2.0

# --- Portfolio ---
# Path to provided sample transaction data; leave blank to use the seeded synthetic portfolio
TRANSACTION_DATA_PATH=
PORTFOLIO_PATH=./portfolio/portfolio_data.csv

# --- Demo ---
DEMO_SEED=42
DEMO_STEP_SECONDS=10
# Scripted SYNTHETIC demo story played in SCENARIO mode
DEMO_STORY_PATH=./data/scenarios/demo_story.json
# REPLAY mode: how many of the most recent cached real documents to stream, and the delay between them
REPLAY_LIMIT=120
REPLAY_DELAY_S=0.5
